FROM node:20-bookworm-slim AS fe
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend .
RUN npm run build

FROM python:3.12-slim-bookworm
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget libpq5 ca-certificates curl docker.io \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
      amd64) compose_arch="x86_64" ;; \
      arm64) compose_arch="aarch64" ;; \
      *) echo "Unsupported Docker Compose architecture: $arch" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-${compose_arch}" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
COPY docker/Dockerfile.api ./docker/Dockerfile.api
COPY tests/wiremock/mappings ./tests/wiremock/mappings
COPY tests/wiremock/__files ./tests/wiremock/__files
COPY --from=fe /fe/dist ./frontend/dist

# Runtime source identity (API ↔ Scheduler must share this image lineage).
# GIT_SHA alone is insufficient on dirty worktrees — SOURCE_DIGEST + GIT_DIRTY required.
ARG GDC_BUILD_GIT_SHA=unknown
ARG GDC_BUILD_GIT_DIRTY=unknown
ARG GDC_BUILD_SOURCE_DIGEST=
ARG GDC_BUILD_WORKTREE=unknown
ARG GDC_BUILD_TIME=unknown
ENV GDC_BUILD_GIT_SHA=${GDC_BUILD_GIT_SHA} \
    GDC_BUILD_GIT_DIRTY=${GDC_BUILD_GIT_DIRTY} \
    GDC_BUILD_SOURCE_DIGEST=${GDC_BUILD_SOURCE_DIGEST} \
    GDC_BUILD_WORKTREE=${GDC_BUILD_WORKTREE} \
    GDC_BUILD_TIME=${GDC_BUILD_TIME}
RUN python - <<'PY'
from pathlib import Path
import hashlib
import json
import os

repo = Path("/app")
skip_dirs = {"__pycache__", ".git", "node_modules", "cache", "logs"}
inputs = [
    repo / "app",
    repo / "alembic",
    repo / "alembic.ini",
    repo / "requirements.txt",
    repo / "docker" / "Dockerfile.api",
]
hasher = hashlib.sha256()
files: list[Path] = []
for target in inputs:
    if target.is_file():
        files.append(target)
    elif target.is_dir():
        for path in sorted(target.rglob("*")):
            if not path.is_file():
                continue
            if any(part in skip_dirs for part in path.parts):
                continue
            if path.name == "BUILD_IDENTITY.json" or path.suffix == ".pyc":
                continue
            files.append(path)
for path in sorted(set(files)):
    rel = path.relative_to(repo).as_posix()
    hasher.update(rel.encode("utf-8"))
    hasher.update(b"\0")
    hasher.update(path.read_bytes())
    hasher.update(b"\0")
computed = hasher.hexdigest()
provided = (os.environ.get("GDC_BUILD_SOURCE_DIGEST") or "").strip()
source_digest = provided or computed

dirty_raw = (os.environ.get("GDC_BUILD_GIT_DIRTY") or "unknown").strip().lower()
if dirty_raw in {"true", "1", "yes", "on"}:
    git_dirty: bool | str = True
elif dirty_raw in {"false", "0", "no", "off"}:
    git_dirty = False
else:
    git_dirty = os.environ.get("GDC_BUILD_GIT_DIRTY") or "unknown"

ident = {
    "git_sha": os.environ.get("GDC_BUILD_GIT_SHA") or "unknown",
    "git_dirty": git_dirty,
    "source_digest": source_digest,
    "worktree": os.environ.get("GDC_BUILD_WORKTREE") or "unknown",
    "built_at": os.environ.get("GDC_BUILD_TIME") or "unknown",
    "route_processing_canonical": True,
}
Path("/app/app/BUILD_IDENTITY.json").write_text(
    json.dumps(ident, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
print("baked_source_digest", ident["source_digest"][:16])
print("baked_git_dirty", ident["git_dirty"])
PY

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=8 \
  CMD wget -qO- http://127.0.0.1:8000/health >/dev/null || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
