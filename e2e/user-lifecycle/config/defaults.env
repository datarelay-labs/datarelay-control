# Real Browser Operator E2E — disposable lab (shared fixtures, isolated DB/API/UI)
COMPOSE_PROFILES=e2e
GDC_TEST_CONTAINER_PREFIX=gdc
GDC_ROUTE_PROCESSING_ENABLED=true
GDC_PROTECTION_ENABLED=true
GDC_SENSITIVE_DETECTION_ENABLED=true
GDC_CLASSIFICATION_ENABLED=true
GDC_E2E_API_WORKERS=2
GDC_E2E_API_PORT=18010
GDC_E2E_UI_PORT=4174
REQUIRE_AUTH=false
ENABLE_DEV_VALIDATION_LAB=false
GDC_ENABLE_IN_PROCESS_SCHEDULER=false

WIREMOCK_BASE_URL=http://127.0.0.1:28080
E2E_WEBHOOK_ECHO_URL=http://127.0.0.1:18091
GDC_E2E_WEBHOOK_COLLECTOR_URL=http://127.0.0.1:18192
GDC_E2E_SYSLOG_COLLECTOR_API_URL=http://127.0.0.1:18193

# DATABASE_URL set per-run by shell (disposable DB on postgres-test 55441)
SOURCE_E2E_MINIO_ENDPOINT=http://127.0.0.1:59000
SOURCE_E2E_MINIO_ACCESS_KEY=gdcminioaccess
SOURCE_E2E_MINIO_SECRET_KEY=gdcminioaccesssecret12
SOURCE_E2E_MINIO_BUCKET=gdc-source-e2e
SOURCE_E2E_PG_FIXTURE_URL=postgresql://gdc_fixture:gdc_fixture_pw@127.0.0.1:55433/gdc_query_fixture
SOURCE_E2E_SFTP_HOST=127.0.0.1
SOURCE_E2E_SFTP_PORT=22222
SOURCE_E2E_SFTP_USER=gdc
SOURCE_E2E_SFTP_PASSWORD=devlab123

GDC_E2E_NAME_PREFIX="[ULC_E2E]"
GDC_E2E_PID_DIR=e2e/reports/.pids-user-lifecycle
GDC_E2E_LOG_DIR=e2e/reports/lab-logs-user-lifecycle
GDC_STREAM_RUN_LOCK_DIR=/tmp/gdc-stream-run-locks-user-lifecycle
