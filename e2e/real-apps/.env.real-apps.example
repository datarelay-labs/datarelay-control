FRAPPE_DOCKER_URL=http://gdc-frappe-session-lab:8087
FRAPPE_USER=Administrator
FRAPPE_PASSWORD=frappe-e2e-pass

WORDPRESS_BASE_URL=http://127.0.0.1:8088
WORDPRESS_DOCKER_URL=http://gdc-wordpress-basic-lab:8088
WP_USER=wp-e2e-user
WP_PASSWORD=wp-e2e-pass

