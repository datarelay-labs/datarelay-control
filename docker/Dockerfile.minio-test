# Test fixture only. Anonymous pulls of the published MinIO container images
# are unauthorized. Install the pinned first-party GitHub release binary
# RELEASE.2025-04-22T22-12-26Z (linux-amd64).
FROM alpine:3.22

ARG MINIO_URL=https://github.com/minio/minio/releases/download/RELEASE.2025-04-22T22-12-26Z/minio.linux-amd64.RELEASE.2025-04-22T22-12-26Z
ARG MINIO_SHA256=53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c

RUN apk add --no-cache ca-certificates curl \
 && curl -fsSL -o /usr/bin/minio "${MINIO_URL}" \
 && echo "${MINIO_SHA256}  /usr/bin/minio" | sha256sum -c - \
 && chmod 755 /usr/bin/minio \
 && apk del curl

EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
