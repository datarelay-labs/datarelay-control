# Real Application E2E credentials — DO NOT COMMIT filled values.
# Copy to .env.real-apps (gitignored) and fill only what you enable.

# HubSpot
# HUBSPOT_ACCESS_TOKEN=

# Shopify
# SHOPIFY_SHOP=
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2025-01

# Stripe (test mode only)
# STRIPE_TEST_SECRET_KEY=

# Atlassian
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_SITE=

# Microsoft 365 / Graph
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=

# Salesforce
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# SALESFORCE_INSTANCE_URL=

# ServiceNow PDI
# SERVICENOW_INSTANCE_URL=
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# Slack
# SLACK_BOT_TOKEN=

# QuickBooks sandbox
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REFRESH_TOKEN=
# QBO_REALM_ID=

# Okta
# OKTA_DOMAIN=
# OKTA_API_TOKEN=

# GitHub
# GITHUB_TOKEN=

# Airtable / Notion (optional)
# AIRTABLE_PAT=
# NOTION_TOKEN=
