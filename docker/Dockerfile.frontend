# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS fe
WORKDIR /fe
ARG VITE_OSS_RELEASE_MODE=true
ARG VITE_AI_GATEWAY_FOUNDATION=false
ENV VITE_OSS_RELEASE_MODE=${VITE_OSS_RELEASE_MODE}
ENV VITE_AI_GATEWAY_FOUNDATION=${VITE_AI_GATEWAY_FOUNDATION}
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc,required=true npm ci
COPY frontend .
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=fe /fe/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
